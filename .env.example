# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=everia-media

# Stripe (publishable key only — never put a secret key in this file)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# Public guest experience. This HTTPS URL is encoded in the event QR codes.
EXPO_PUBLIC_WEB_APP_URL=https://app.your-domain.com

# Expo
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
EXPO_PUBLIC_APP_SCHEME=everia
EXPO_PUBLIC_APP_VERSION=1.0.0
